{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ToolTree",
  "version": "0.1.0",
  "identifier": "com.tooltree.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1423",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ToolTree",
        "width": 1180,
        "height": 760,
        "minWidth": 760,
        "minHeight": 480,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false,
        "backgroundColor": "#17191e",
        "theme": "Dark"
      },
      {
        "label": "panel",
        "title": "Clipboard",
        "url": "index.html#panel",
        "width": 420,
        "height": 540,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visibleOnAllWorkspaces": true,
        "dragDropEnabled": false,
        "backgroundColor": "#17191e",
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Developer toolbox and clipboard history",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
